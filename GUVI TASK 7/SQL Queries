SELECT m.title, g.genre_name
FROM Movies m
JOIN Movie_Genre mg ON m.movie_id = mg.movie_id
JOIN Genre g ON g.genre_id = mg.genre_id;


SELECT m.title,
       u.username,
       r.rating,
       r.review_text
FROM Reviews r
JOIN Movies m ON r.movie_id = m.movie_id
JOIN Userss u ON r.user_id = u.user_id;


